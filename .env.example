# PostgreSQL
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring123

# JWT — générer avec: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_MINIMUM_512_BITS_BASE64_ENCODED_SECRET_KEY_FOR_JWT_SIGNING

# Mailtrap Sandbox (tests : les messages restent dans la boîte Mailtrap)
# Pour l'envoi réel vers des destinataires, utilisez les identifiants SMTP
# Email Sending de Mailtrap et un domaine expéditeur vérifié.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace-with-your-mailtrap-sandbox-username
MAIL_PASS=replace-with-your-mailtrap-sandbox-password
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_ENABLED=true
MAIL_FROM=alerts@your-verified-domain.example
MAIL_FROM_NAME=Monitoring Monétique
APP_NOTIFICATIONS_ALERT_EMAIL_ENABLED=true

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173

# SVFE Oracle (optionnel — laisser vide si non disponible)
SVFE_DB_URL=jdbc:oracle:thin:@localhost:1521:svfe
SVFE_DB_USER=svfe_user
SVFE_DB_PASS=svfe_pass

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SSE_URL=http://localhost:8080/api/sse/stream
